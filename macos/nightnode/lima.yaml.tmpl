# Generated by nightnode. Home directory of the Mac is not mounted.
minimumLimaVersion: "2.0.0"
base:
  - template:ubuntu-lts
arch: aarch64
vmType: vz
cpus: __CPUS__
memory: __MEMORY__
disk: __DISK__
mounts: []
containerd:
  system: false
  user: false
portForwards: []
provision:
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      swapoff -a || true
      sed -i '/[[:space:]]swap[[:space:]]/d' /etc/fstab || true
