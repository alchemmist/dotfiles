{
  "skillListingBudgetFraction": 0.05,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "ANTHROPIC_BASE_URL": "https://api.eliza.yandex.net/raw/anthropic"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(python3 /tmp/fq_sync.py:*)",
      "Read",
      "Glob",
      "Grep"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/notify.sh Glass"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/notify.sh Ping"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh /Users/antonmoss/.stefania/hooks/session-start-env.zsh",
            "timeout": 30,
            "statusMessage": "Подтягиваю окружение из ~/.zshrc"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonmoss/.local/share/yandex-aisuite/runner hook run --type session_start --name session_state_gc --agent claude",
            "async": true,
            "__generator": "ya_tool_aisuite_meta"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonmoss/.venvs/stefania/bin/python /Users/antonmoss/.claude/skills/stefania-memory/hooks/user-prompt-submit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonmoss/.venvs/stefania/bin/python /Users/antonmoss/.claude/skills/stefania-memory/hooks/pre-compact.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/antonmoss/.venvs/stefania/bin/python /Users/antonmoss/.claude/skills/stefania-memory/hooks/session-end.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/antonmoss/.stefania/statusline-with-tip.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
