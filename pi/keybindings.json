{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "app.session.toggleSort": [],
  "app.models.save": [],
  "app.thinking.save": [],
  "tui.input.tab": [],
  "tui.input.newLine": [
    "shift+enter",
    "ctrl+j"
  ],
  "app.message.followUp": "tab",
  "app.clipboard.pasteImage": ["ctrl+v", "alt+v"],
  "tui.altScreen.search": "ctrl+shift+alt+f",
  "tui.editor.historyPrevious": "ctrl+p",
  "tui.editor.historyNext": "ctrl+n",
  "app.model.cycleForward": "ctrl+shift+p",
  "app.model.cycleBackward": "ctrl+shift+n",
  "app.thinking.cycle": "ctrl+shift+t"
}
