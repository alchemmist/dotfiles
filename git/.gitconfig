[init]
	defaultBranch = main
[user]
	email = anton.ingrish@gmail.com
	name = alchemmist
[core]
	editor = nvim
	quotePath = false
[url "git@github.com:"]
    insteadOf = git@github.com:Alchemmist/

[url "git@github-sub:"]
    insteadOf = git@github.com:flamelen/
[http]
	postBuffer = 524288000
	maxRequests = 100
[fetch]
	prune = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[delta]
    side-by-side = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
